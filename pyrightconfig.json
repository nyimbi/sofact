{
	"include": [
		"src",
		"tests"
	],
	"pythonVersion": "3.13",
	"typeCheckingMode": "strict",
	"reportMissingTypeStubs": false,
	"venvPath": ".",
	"venv": ".venv",
	"extraPaths": [
		"src",
		".venv/lib/python3.13/site-packages",
		"tests/ci"
	],
	"executionEnvironments": [
		{
			"root": ".",
			"extraPaths": [
				"src",
				".venv/lib/python3.13/site-packages",
				"tests/ci"
			]
		}
	]
}
